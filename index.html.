    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map-home').setView([-23.295, -50.077], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var pontos = [
            { lat: -23.2952, lng: -50.0772, title: "Igreja Matriz Santo Antônio", desc: "Marco Zero da cidade." },
            { lat: -23.2875, lng: -50.0710, title: "Morro do Bim", desc: "Mirante da Cidade e Cristo." },
            { lat: -23.2910, lng: -50.0820, title: "Estação Ferroviária Histórica", desc: "Patrimônio Cultural." }
        ];

        pontos.forEach(function(p) {
            L.marker([p.lat, p.lng]).addTo(map).bindPopup("<b>" + p.title + "</b><br>" + p.desc);
        });

        const weatherToggleBtn = document.getElementById('weatherToggleBtn');
        const weatherMenu = document.getElementById('weatherMenu');
        const overlay = document.getElementById('weather-overlay');

        weatherToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            weatherMenu.classList.toggle('show');
        });

        document.addEventListener('click', () => {
            weatherMenu.classList.remove('show');
        });

        function setWeatherTheme(themeClass) {
            document.body.className = themeClass === 'default' ? '' : themeClass;
            weatherMenu.classList.remove('show');
            overlay.innerHTML = '';

            if (themeClass === 'theme-chuva') {
                for (let i = 0; i < 40; i++) {
                    const drop = document.createElement('div');
                    drop.className = 'rain-drop';
                    drop.style.left = Math.random() * 100 + 'vw';
                    drop.style.animationDuration = (0.5 + Math.random() * 0.5) + 's';
                    drop.style.animationDelay = Math.random() * 2 + 's';
                    overlay.appendChild(drop);
                }
            } else if (themeClass === 'theme-neve') {
                const flakes = ['❄', '❅', '❆'];
                for (let i = 0; i < 30; i++) {
                    const flake = document.createElement('div');
                    flake.className = 'snowflake';
                    flake.innerText = flakes[Math.floor(Math.random() * flakes.length)];
                    flake.style.left = Math.random() * 100 + 'vw';
                    flake.style.animationDuration = (3 + Math.random() * 4) + 's';
                    flake.style.animationDelay = Math.random() * 3 + 's';
                    flake.style.fontSize = (0.8 + Math.random() * 1) + 'rem';
                    overlay.appendChild(flake);
                }
            } else if (themeClass === 'theme-tempestade') {
                document.body.classList.add('lightning-flash');
            } else if (themeClass === 'theme-seca') {
                const heat = document.createElement('div');
                heat.className = 'heat-wave';
                overlay.appendChild(heat);
            }
        }
    </script>
